# All secrets stay on the backend. Never prefix a secret with VITE_.
PORT=3000
HOST=127.0.0.1
LLM_BASE_URL=https://relay.nccnxta.cn/v1
LLM_MODEL=gpt-6.1-sol
LLM_API_KEY=
LLM_TIMEOUT_MS=180000
# OpenAI-compatible Chat Completions with Bearer authentication.
# Use a key issued for this gateway; never reuse a previous provider's key.
# Only final-answer text is used. Provider-specific thinking parameters are not sent.
IMA_OPENAPI_CLIENTID=
IMA_OPENAPI_APIKEY=
IMA_KB_NAME=任德耀新建华为PC知识库
IMA_ACCOUNT_LABEL=比赛演示账号
# Optional: override local paths (absolute or relative to the project root)
# LOCAL_KB_ROOT=
# IMA_SKILL_PATH=ima-skill/ima_api.cjs
# Independent image generation; text credentials are never reused.
IMAGE_BASE_URL=https://relay.styxgate.top/v1
IMAGE_MODEL=gpt-image-2.5
IMAGE_API_KEY=
IMAGE_TIMEOUT_MS=300000
# Formal Canva developer application; enable MCP and register this exact callback.
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
CANVA_REDIRECT_URI=http://127.0.0.1:3000/api/integrations/canva/callback

# All secrets stay on the backend. Never prefix a secret with VITE_.
PORT=3000
HOST=127.0.0.1
LLM_BASE_URL=https://api.openai-next.com
LLM_MODEL=claude-opus-5
LLM_API_KEY=
LLM_TIMEOUT_MS=180000
# DeepSeek Flash also supports this app's Anthropic Messages protocol.
# Set these instead of the gateway values above, and use your DeepSeek API key:
# LLM_BASE_URL=https://api.deepseek.com/anthropic
# LLM_MODEL=deepseek-flash
# LLM_API_KEY=YOUR_DEEPSEEK_API_KEY
# LLM_THINKING=disabled
# Leave LLM_THINKING unset (or default) to use the provider's default thinking mode.
IMA_OPENAPI_CLIENTID=
IMA_OPENAPI_APIKEY=
IMA_KB_NAME=任德耀新建华为PC知识库
IMA_ACCOUNT_LABEL=比赛演示账号
# Optional: override local paths (absolute or relative to the project root)
# LOCAL_KB_ROOT=
# IMA_SKILL_PATH=ima-skill/ima_api.cjs
